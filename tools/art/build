#!/usr/bin/env bash
# Renders the art sources (tools/art/src/*.svg) into game/art/*.png with Inkscape.
#   tools/art/build              render every source
#   tools/art/build blood_pool   render only the named sources
# Each PNG is the SVG's page at its own pixel size, on a transparent background (SVG filters such as
# feTurbulence and feDisplacementMap are rendered by Inkscape). A development tool only: the PNGs are
# committed, so building or running the game never needs Inkscape. Set INKSCAPE to use another binary.
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
src="$root/tools/art/src"
out="$root/game/art"
inkscape="${INKSCAPE:-}"
if [ -z "$inkscape" ]; then
  if [ -x /Applications/Inkscape.app/Contents/MacOS/inkscape ]; then inkscape=/Applications/Inkscape.app/Contents/MacOS/inkscape
  else inkscape="$(command -v inkscape || true)"; fi
fi
[ -n "$inkscape" ] || { echo "tools/art/build: Inkscape not found (set INKSCAPE)" >&2; exit 1; }
mkdir -p "$out"

if [ "$#" -gt 0 ]; then
  names=("$@")
else
  names=()
  for svg in "$src"/*.svg; do names+=("$(basename "$svg" .svg)"); done
fi

for name in "${names[@]}"; do
  svg="$src/$name.svg"
  [ -f "$svg" ] || { echo "tools/art/build: no source $svg" >&2; exit 1; }
  "$inkscape" "$svg" --export-type=png --export-area-page --export-background-opacity=0 \
    --export-filename="$out/$name.png" >/dev/null 2>&1
  echo "game/art/$name.png"
done
