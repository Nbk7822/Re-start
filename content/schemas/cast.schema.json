{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The cast: who each person fundamentally is (natures come from Truths)",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["key", "nameKey", "species", "signatureTrait", "role", "color"],
    "properties": {
      "key": { "$ref": "#/$defs/id" },
      "nameKey": { "$ref": "#/$defs/locKey" },
      "species": { "$ref": "#/$defs/id" },
      "signatureTrait": { "$ref": "#/$defs/id" },
      "role": { "$ref": "#/$defs/id" },
      "otherworlder": { "type": "boolean" },
      "startsInCamp": { "type": "boolean" },
      "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
      "arrivalDays": {
        "description": "[first, last] day of the first year (Day 1 first) within which they arrive, the day drawn from Dice; omit to be shuffled in with the other wanderers (ADR-0022)",
        "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "locKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$" }
  }
}
