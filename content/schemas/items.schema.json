{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Items",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "nameKey"],
    "properties": {
      "id": { "$ref": "#/$defs/id" },
      "nameKey": { "$ref": "#/$defs/locKey" },
      "nutrition": { "type": "integer", "minimum": 0, "maximum": 1000 },
      "spoilDays": { "type": "integer", "minimum": 0 },
      "stackLimit": { "type": "integer", "minimum": 1 }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "locKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$" }
  }
}
