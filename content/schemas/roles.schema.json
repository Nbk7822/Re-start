{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roles: default work priorities (1 = first, 4 = last)",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "nameKey", "priorities"],
    "properties": {
      "id": { "$ref": "#/$defs/id" },
      "nameKey": { "$ref": "#/$defs/locKey" },
      "priorities": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["work", "priority"],
          "properties": {
            "work": { "$ref": "#/$defs/id" },
            "priority": { "type": "integer", "minimum": 0, "maximum": 4 }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "locKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$" }
  }
}
