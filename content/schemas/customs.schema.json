{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Customs: one rule with one hook each. The kind names behaviour implemented in code; params are its integers (ADR-0023)",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "kind", "params"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "kind": { "enum": ["greeting", "blood_stance", "guest_right", "leader_last", "debt_of_honour", "festival", "sacred_tree"] },
      "params": {
        "type": "object",
        "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
        "additionalProperties": { "type": "integer" }
      }
    }
  }
}
